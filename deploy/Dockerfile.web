# spark.fun web — build the React app, then serve it as static files.
FROM node:22-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000

COPY frontend/ ./

# CRA inlines env at build time, so the chain and factory are baked into the
# bundle. Rebuild the image to change them.
ARG REACT_APP_BACKEND_URL=/
ARG REACT_APP_CHAIN_ID=4663
ARG REACT_APP_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ARG REACT_APP_EXPLORER_URL=https://robinhoodchain.blockscout.com
ARG REACT_APP_SPARK_FACTORY=
ARG REACT_APP_USDC_ADDRESS=
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL \
    REACT_APP_CHAIN_ID=$REACT_APP_CHAIN_ID \
    REACT_APP_RPC_URL=$REACT_APP_RPC_URL \
    REACT_APP_EXPLORER_URL=$REACT_APP_EXPLORER_URL \
    REACT_APP_SPARK_FACTORY=$REACT_APP_SPARK_FACTORY \
    REACT_APP_USDC_ADDRESS=$REACT_APP_USDC_ADDRESS \
    CI=false \
    # Measured peak is ~2 GB. Capping the heap makes the build fail
    # predictably rather than thrash until the OOM killer arrives.
    NODE_OPTIONS=--max-old-space-size=2048

RUN yarn build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
