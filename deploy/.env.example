# Copy to deploy/.env on the server and fill in.
# docker compose reads this file automatically.

# Port the test site listens on. 80/443 are taken by CyberPanel here.
WEB_PORT=8080

# Any long random string. Generate one: openssl rand -hex 32
SECRET_KEY=

# Restrict once the domain is fixed, e.g. https://srv1505182.hstgr.cloud
CORS_ORIGINS=*

# ---- chain ----
SPARK_CHAIN_ID=4663
SPARK_RPC_URL=https://rpc.mainnet.chain.robinhood.com
SPARK_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Address printed by `npm run deploy:mainnet`, and the block it landed in.
# Leave both empty to run read-only: the app says so instead of pretending.
SPARK_FACTORY_ADDRESS=
SPARK_DEPLOY_BLOCK=

# Free at dashboard.reown.com. Empty disables the WalletConnect button and
# the UI explains why.
WALLETCONNECT_PROJECT_ID=

# Optional, enables the USDC pair once configureQuote has been called.
USDC_ADDRESS=

DB_NAME=sparkfun
