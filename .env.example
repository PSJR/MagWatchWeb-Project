# ---------------------------------------------------------------------------
# spark.fun — configuration
# Copy to backend/.env and frontend/.env. Nothing here is a secret except
# DEPLOYER_PRIVATE_KEY, which belongs only on the machine that runs the deploy.
# ---------------------------------------------------------------------------

# ---- frontend (frontend/.env) ----
REACT_APP_BACKEND_URL=http://localhost:8001

# Robinhood Chain mainnet. Testnet is 46630 with the testnet RPC.
REACT_APP_CHAIN_ID=4663
REACT_APP_RPC_URL=https://rpc.mainnet.chain.robinhood.com
REACT_APP_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Address printed by `npm run deploy:mainnet`. Until this is set the app runs
# read-only and says so instead of pretending.
REACT_APP_SPARK_FACTORY=

# Free, from dashboard.reown.com. WalletConnect cannot initialise without it.
REACT_APP_WALLETCONNECT_PROJECT_ID=

# Optional: enables the USDC pair once configureQuote has been called.
REACT_APP_USDC_ADDRESS=

# ---- backend (backend/.env) ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=sparkfun
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

SPARK_CHAIN_ID=4663
SPARK_RPC_URL=https://rpc.mainnet.chain.robinhood.com
SPARK_FACTORY_ADDRESS=
# Block the factory was deployed in — the indexer starts here instead of 0.
SPARK_DEPLOY_BLOCK=
# Lower this if your RPC caps eth_getLogs spans.
SPARK_LOG_SPAN=9000
# Require a valid signature on wallet login. Never set this to false in production.
SPARKFUN_REQUIRE_SIGNATURE=true

# ---- contracts (contracts/.env, deploy machine only) ----
# DEPLOYER_PRIVATE_KEY=0x...
# TREASURY=0x...
